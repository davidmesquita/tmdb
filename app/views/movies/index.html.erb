<div class="card">
    <div class="card-body">
        <h1>Home</h1>
        <%= form_with url: search_movies_path, method: :get do |form|%>
            <%= form.text_field :query %>
            <%= form.submit "Search" %>
        <%end%>

        <div id="movies">
            <%@movies.each do |movie| %>
                <div style="display: none;">
                </div>
                <div class="movie">
                    <%=render CardComponent.new(movie: movie)%>
                </div>
            <%end%>
        </div>
    </div>
</div>